# Copy this file to .env and fill in your keys. Keep .env private and never commit it.
# Get Groq keys at https://console.groq.com/keys
GROQ_API_KEY=your_primary_groq_key_here
# Optional fallback keys. Werk rotates when a key is unavailable or exhausted.
# GROQ_API_KEY_2=your_second_groq_key_here
# GROQ_API_KEY_3=your_third_groq_key_here
# GROQ_API_KEYS=additional_key_1,additional_key_2
# Optional model override (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Hosted marketplace provider. It is disabled unless both settings below are set.
# MARKETPLACE_PROVIDER_ENABLED=true
# Use a unique secret with at least 32 characters. Never commit the real value.
# MARKETPLACE_TOKEN_SECRET=replace_with_a_unique_32_character_secret
# Optional provider limits. Defaults: 55 seconds, 1 concurrent request, 4 requests per hour per caller.
# MARKETPLACE_REQUEST_TIMEOUT_MS=55000
# MARKETPLACE_MAX_CONCURRENT=1
# MARKETPLACE_RATE_LIMIT_WINDOW_MS=3600000
# MARKETPLACE_RATE_LIMIT_MAX=4
