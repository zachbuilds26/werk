# Copy this file to .env and fill in your keys. Keep .env private and never commit it.
# Get Groq keys at https://console.groq.com/keys
GROQ_API_KEY=your_primary_groq_key_here
# Optional fallback keys. Werk rotates when a key is unavailable or exhausted.
# GROQ_API_KEY_2=your_second_groq_key_here
# GROQ_API_KEY_3=your_third_groq_key_here
# GROQ_API_KEYS=additional_key_1,additional_key_2
# Optional model override (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
